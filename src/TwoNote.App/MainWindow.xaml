<Window
    x:Class="TwoNote.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TwoNote">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <TitleBar x:Name="AppTitleBar" Title="TwoNote" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TwoNote.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" Width="360" PlaceholderText="Search pages (Ctrl+F)" QueryIcon="Find"
                                Visibility="Collapsed" AutomationProperties.Name="Search pages" UpdateTextOnSelect="False" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel x:Name="TitleButtons" Orientation="Horizontal" Spacing="2" Visibility="Collapsed" VerticalAlignment="Center">
                    <Button x:Name="PanesButton" Background="Transparent" BorderThickness="0" Width="40" Height="32" Padding="0"
                            AutomationProperties.Name="Hide side panes">
                        <FontIcon x:Name="PanesIcon" Glyph="&#xE89F;" FontSize="15" />
                    </Button>
                    <Button x:Name="SyncButton" Background="Transparent" BorderThickness="0" Height="32" Padding="10,0"
                            AutomationProperties.Name="Sync status" ToolTipService.ToolTip="Sync status">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="SyncIcon" Glyph="&#xE895;" FontSize="14" />
                            <TextBlock x:Name="SyncText" Text="Synced" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="SyncFlyout" Placement="Bottom" ShouldConstrainToRootBounds="True">
                                <StackPanel x:Name="SyncDetails" Width="340" Spacing="6" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="LockButton" Background="Transparent" BorderThickness="0" Width="40" Height="32" Padding="0"
                            AutomationProperties.Name="Lock" ToolTipService.ToolTip="Lock (Ctrl+L)">
                        <FontIcon Glyph="&#xE72E;" FontSize="15" />
                    </Button>
                    <Button x:Name="SettingsButton" Background="Transparent" BorderThickness="0" Width="40" Height="32" Padding="0"
                            AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <!-- A Canvas so the zoomed content can be laid out larger or smaller than the window without being
             clipped: Host is sized to (window / zoom) and scaled by zoom, see ApplyZoom. -->
        <Canvas x:Name="ZoomCanvas" Grid.Row="1">
            <Grid x:Name="Host" />
        </Canvas>
    </Grid>
</Window>
