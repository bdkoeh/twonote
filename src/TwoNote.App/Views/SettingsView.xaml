<UserControl
    x:Class="TwoNote.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,14,0,4" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Padding="24,8,24,32" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Width="40" Height="36" Padding="0"
                        AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Esc)">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Account" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Server" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="ServerText" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.Name="Server address" />
                    <TextBlock Grid.Row="1" Text="Username" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="UserText" Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" AutomationProperties.Name="Username" />
                </Grid>
            </Border>

            <TextBlock Text="Devices" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="140,*,Auto">
                        <TextBlock Text="This device" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceNameText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Name of this device" />
                        <Button x:Name="RenameDeviceButton" Grid.Column="2" Content="Rename…" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="DevicesStatus" Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="Devices that can open this account:" />
                        <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="Refresh" />
                    </Grid>
                    <StackPanel x:Name="DeviceList" Spacing="6" />
                </StackPanel>
            </Border>

            <TextBlock Text="Security" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Lock automatically" />
                            <TextBlock Style="{StaticResource Secondary}" Text="After this long without keyboard or mouse input in TwoNote." />
                        </StackPanel>
                        <ComboBox x:Name="AutoLockBox" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" AutomationProperties.Name="Lock automatically after" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Master password" />
                            <TextBlock Style="{StaticResource Secondary}" Text="Changing it signs your other devices out; they ask for the new password." />
                        </StackPanel>
                        <Button x:Name="ChangePasswordButton" Grid.Column="1" Content="Change password…" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Secret Key and Emergency Kit" />
                            <TextBlock Style="{StaticResource Secondary}" Text="Needed, with your password, to add a device. You are asked for your password first." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ShowKeyButton" Content="Show Secret Key…" />
                            <Button x:Name="SaveKitButton" Content="Save Emergency Kit…" />
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="SecurityInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="150" AutomationProperties.Name="Theme">
                            <ComboBoxItem Content="Use system setting" Tag="system" />
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Zoom" />
                            <TextBlock Style="{StaticResource Secondary}" Text="Size of text and controls below the title bar. Ctrl+plus, Ctrl+minus and Ctrl+0 change it from a page." />
                        </StackPanel>
                        <ComboBox x:Name="ZoomBox" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" AutomationProperties.Name="Zoom" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Sign out" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Sign out of this device" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Removes the local copy of your notes and the Secret Key from this PC. Your notes stay on the server and on your other devices." />
                    </StackPanel>
                    <Button x:Name="SignOutButton" Grid.Column="1" Content="Sign out…" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="AboutText" Style="{StaticResource Secondary}" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
